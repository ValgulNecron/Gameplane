FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src

# tunnel's go.mod currently has no gameaction requirement (no local
# replace directive), so this COPY is a no-op for the build. It is kept
# only for structural parity with sentinel/Dockerfile, api/Dockerfile, and
# agent/Dockerfile, which do depend on gameaction.
COPY gameaction/ ./gameaction/
COPY tunnel/go.mod tunnel/go.sum* ./tunnel/
WORKDIR /src/tunnel
RUN go mod download

WORKDIR /src
COPY tunnel/ ./tunnel/
WORKDIR /src/tunnel

ARG VERSION=dev
# Cross-compile on the build host ($BUILDPLATFORM above) rather than under
# QEMU emulation: multi-arch release builds of the arm64 image were slow
# enough to hit the release job timeout.
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/tunnel .

# Build stage to download and verify frp binary
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS frp-stage
ARG FRP_VERSION=0.70.1
ARG TARGETARCH
ARG FRP_SHA256_amd64=333da23d1b9009d7c01638e9ba38cf4600f7d37d393f854e96ee1396adefa9a6
ARG FRP_SHA256_arm64=3990f396a9a490ee7f0e5f355287750ed41520064ed999eab443b5e9a78d773d

RUN apk add --no-cache curl tar
WORKDIR /tmp
RUN mkdir -p /out && \
    if [ "$TARGETARCH" = "arm64" ]; then \
      FRP_ARCH="arm64"; \
      FRP_SHA256="$FRP_SHA256_arm64"; \
    else \
      FRP_ARCH="amd64"; \
      FRP_SHA256="$FRP_SHA256_amd64"; \
    fi && \
    curl -fsSL "https://github.com/fatedier/frp/releases/download/v${FRP_VERSION}/frp_${FRP_VERSION}_linux_${FRP_ARCH}.tar.gz" \
    -o frp.tar.gz && \
    echo "${FRP_SHA256}  frp.tar.gz" | sha256sum -c - && \
    tar xzf frp.tar.gz && \
    mv "frp_${FRP_VERSION}_linux_${FRP_ARCH}/frpc" /out/frpc && \
    chmod +x /out/frpc

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/tunnel /tunnel
COPY --from=frp-stage /out/frpc /usr/local/bin/frpc
USER 65532:65532
EXPOSE 25565/tcp 25565/udp
ENTRYPOINT ["/tunnel"]
