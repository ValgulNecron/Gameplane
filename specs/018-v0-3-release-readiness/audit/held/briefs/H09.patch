+		t.Fatalf("missing token; body=%s", body)
+	}
+	if status, _ := shareReq(t, h, "GET", "/shares/"+token, nil, nil, "203.0.113.46:1"); status != http.StatusOK {
+		t.Fatalf("resolve before delete: status = %d, want 200", status)
