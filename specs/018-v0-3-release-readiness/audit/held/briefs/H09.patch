+func TestResolveOrLinkUser_DeletedUserIsProvisionedAgain(t *testing.T) {
+	store := newAuthDB(t)
+	o := &OIDC{}
+	o.AttachStore(store)
+	ctx := context.Background()
+
+	first, _, err := o.resolveOrLinkUser(ctx, "https://idp", "sub-returning", "returning@x", "Returning", "viewer", "none", false)
